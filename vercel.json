{
  "version": 2,
  "redirects": [
    { "source": "/paquete-fin-semana.html", "destination": "/paquete-golf-burgos.html", "permanent": true },
    { "source": "/paquete-36-hoyos.html", "destination": "/paquete-golf-ilimitado.html", "permanent": true },
    { "source": "/paquete-golf-vino.html", "destination": "/paquete-golf-canalla.html", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/api/hotelbeds-reconfirmation",
      "destination": "/api/hotelbeds-availability?__hb_reconfirm=1"
    },
    {
      "source": "/api/stripe-checkout-session",
      "destination": "/api/booking-voucher?checkout_json=1"
    },
    {
      "source": "/api/socios-login",
      "destination": "/api/socios?action=login"
    },
    {
      "source": "/api/socios-list",
      "destination": "/api/socios?action=list"
    },
    {
      "source": "/api/socios-amigos",
      "destination": "/api/socios?action=amigos"
    }
  ],
  "functions": {
    "api/crear-pago.js": { "maxDuration": 10 },
    "api/hotelbeds-availability.js": { "maxDuration": 15 },
    "api/hotelbeds-list-hotels.js": { "maxDuration": 15 },
    "api/amadeus-availability.js": { "maxDuration": 15 },
    "api/chat-assistente.js": { "maxDuration": 15 },
    "api/webhook-stripe.js": { "maxDuration": 15 },
    "api/contacto-empresa.js": { "maxDuration": 10 },
    "api/promociona-torneo.js": { "maxDuration": 15 },
    "api/reserva-solicitud.js": { "maxDuration": 10 },
    "api/socios.js": { "maxDuration": 10 },
    "api/booking-voucher.js": { "maxDuration": 15 }
  }
}
